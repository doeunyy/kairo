#!/usr/bin/env bash
# Hermes cron wrapper (installed copy; generated by hermes/install.sh). Runs one Kairo report.
set -euo pipefail
KAIRO_ROOT="__KAIRO_ROOT__"
export KAIRO_STATE_DIR="$KAIRO_ROOT/state"
export KAIRO_ENV_FILE="__KAIRO_ENV_FILE__"
cd "$KAIRO_ROOT/core"
exec "$KAIRO_ROOT/core/.venv/bin/python" -m kairo_core.report __KIND__
