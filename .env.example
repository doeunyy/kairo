# Kairo runtime settings. Copy to ~/.a3-kairo/kairo.env (chmod 600) on the laptop;
# in the cloud every secret below comes from Secret Manager. Never commit real values.
# Test accounts only: dedicated Gmail, calendar, Notion workspace and bot with synthetic data.

# ── Hermes ────────────────────────────────────────────────────────────────────────────
HERMES_HOME=~/.a3-kairo
HERMES_CODEX_BASE_URL=http://127.0.0.1:8787
API_SERVER_KEY=                     # 16+ characters; gateway key for graders

# ── Router ────────────────────────────────────────────────────────────────────────────
A3_LOCAL_MODEL=gemma4:e4b
A3_OLLAMA_BASE_URL=http://127.0.0.1:11434   # cloud: laptop tailnet address
A3_OLLAMA_PROXY=                    # cloud: socks5h://127.0.0.1:1055
A3_STATE_DIR=state
A3_LOCAL_MAX_TOKENS=40000
A3_LOCAL_AGENTIC_MAX_TOKENS=8000      # untagged turns above this carry the full tool catalog → cloud

# ── Discord ────────────────────────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_USERS=              # numeric user ID(s), comma-separated
DISCORD_HOME_CHANNEL=               # channel ID for scheduled briefings and alerts

# ── Dedicated test mailbox (Gmail IMAP/SMTP with an app password) ─────────────────────
KAIRO_IMAP_HOST=imap.gmail.com
KAIRO_SMTP_HOST=smtp.gmail.com
KAIRO_SMTP_PORT=465
KAIRO_MAIL_USER=                    # the test address
KAIRO_MAIL_APP_PASSWORD=            # 16-character Google app password
KAIRO_RECIPIENT_ALLOWLIST=          # addresses Kairo may email after human approval
KAIRO_ALERT_LABEL="Kairo Alerts"    # Gmail label that gets a copy of each alert; empty turns it off
# Incoming senders need no list: code sets a trust tier from Gmail's authentication result and the
# domains the user approved per company (Notion "Email Domains"). See docs/security-audit.md.

# ── Dedicated test calendar ───────────────────────────────────────────────────────────
KAIRO_CALENDAR_ICS_URL=             # "Secret address in iCal format": treat like a password.
                                    # Several calendars: comma-separated, no spaces (primary,Kairo Test)
KAIRO_TZ=America/Los_Angeles

# ── Kairo runtime ─────────────────────────────────────────────────────────────────────
KAIRO_ROUTER_URL=http://127.0.0.1:8787   # mail extraction goes through the router as privacy=high
KAIRO_STATE_DIR=state                    # ledger, outbox, cursor, logs, approval key

# ── Notion (dedicated workspace) ──────────────────────────────────────────────────────
KAIRO_NOTION_TOKEN=                 # internal integration secret
KAIRO_NOTION_PARENT_PAGE_ID=        # page shared with the integration; Kairo creates its database here

# ── Cloud only ────────────────────────────────────────────────────────────────────────
TAILSCALE_AUTHKEY=
